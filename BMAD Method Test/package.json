{
  "name": "sql-chatbot-v0",
  "private": true,
  "version": "0.1.0",
  "description": "Minimal full-stack SQL Chatbot (NL->SAFE SQL) with SQLite/PG, OpenAI Responses API (gpt-5-mini)",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently \"tsx watch src/server.ts\" \"npm run -w web dev\"",
    "build": "tsc -p tsconfig.json && npm run -w web build",
    "start": "node dist/server.js",
    "migrate": "knex --knexfile knexfile.cjs migrate:latest",
    "seed": "knex --knexfile knexfile.cjs seed:run",
    "reseed": "knex --knexfile knexfile.cjs migrate:rollback && knex --knexfile knexfile.cjs migrate:latest && knex --knexfile knexfile.cjs seed:run",
    "test": "vitest --run"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "knex": "^3.1.0",
    "nanoid": "^5.0.7",
    "openai": "^4.56.0",
    "pg": "^8.13.0",
    "pino": "^9.3.2",
    "pino-http": "^9.0.0",
    "sqlite3": "^5.1.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "concurrently": "^9.0.1",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "license": "MIT"
}
