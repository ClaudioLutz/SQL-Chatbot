# SQL Chatbot v0 — Environment Example
# Copy this file to ".env" and fill in values as needed.

# LLM provider/model
PROVIDER=openai
OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY= # required to call OpenAI Responses API

# Database (default: SQLite)
KNEX_CLIENT=sqlite3
# For Postgres (uncomment and set both):
# KNEX_CLIENT=pg
# DATABASE_URL=postgres://USER:PASS@localhost:5432/sql_chatbot

# Server
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Optional: use mock translator for local dev/tests without LLM calls
# When set to 1, translator returns a deterministic stub result
# MOCK_TRANSLATOR=1
